# ─── dorr ─────────────────────────────────────────────────────────────────────
# Everything needed to reproduce both halves on Ethereum Sepolia: the
# public-vs-private duel (MEV Shield) and the perps with on-chain settlement.
# Copy to `.env` and fill in the credentials marked REQUIRED; the deploy scripts
# write the rest back to `.env` themselves.

# REQUIRED. Funds the deployment and the searcher bot. Needs ~0.05 Sepolia ETH:
# the lab deploy is ~0.005 and the rest is the adversary's gas and headroom.
ETH_DEPLOYER_ADDRESS=""
ETH_DEPLOYER_KEY=""

# REQUIRED. Org API key — `keeperhub-onboard.ts` mints one over SIWE using the
# deployer key above, and prints it along with the ORGANISATION wallet (a
# different address from the signer, and the one that actually executes).
KEEPERHUB_API_KEY=""
KEEPERHUB_BASE_URL="https://app.keeperhub.com"
KEEPERHUB_ORG_WALLET=""
# REQUIRED for every on-chain write. The web3 integration that SIGNS workflow
# write nodes — get it from `GET /api/integrations` (the `id`, not the address).
# Omit it and every write fails with "exceeded max retries", an error that names
# the retry budget rather than the missing signer and so points nowhere useful.
KEEPERHUB_INTEGRATION_ID=""

# Created on first use by the private lane. Both workflows are created, enabled
# and fired with the org key above — no second credential is needed.
KEEPERHUB_PRIVATE_WORKFLOW_ID=""

# Schedule-triggered workflow: the autonomous private-swap agent. Created by
# scripts/mev-schedule.ts; each run is audited against the mempool observer.
KEEPERHUB_SCHEDULED_WORKFLOW_ID=""
# Applies the perps' PnL batches to the vault. Created on first settlement;
# set it so subsequent runs reuse the workflow instead of creating a new one.
DORR_SETTLEMENT_WORKFLOW_ID=""
# The autonomous agent's cadence and trade size. Cron is UTC. The operator
# re-quotes this workflow every 20 minutes so its standing slippage floor
# tracks the pool — without that it eventually fails with SlippageExceeded.
KEEPERHUB_SCHEDULED_CRON="*/15 * * * *"
KEEPERHUB_SCHEDULED_AMOUNT_IN="2"

# Sepolia. The WS endpoint is not optional: the searcher subscribes to
# `newPendingTransactions`, which plain HTTP RPC cannot deliver.
ETH_NETWORK="sepolia"
ETH_CHAIN_ID="11155111"
ETH_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
ETH_WS_URL="wss://ethereum-sepolia-rpc.publicnode.com"
ETH_EXPLORER="https://sepolia.etherscan.io"

# The lab. Written by mev-deploy.ts.
MEV_BASE_TOKEN=""
MEV_QUOTE_TOKEN=""
MEV_POOL=""

# The adversary. Generated by mev-deploy.ts if absent; it holds its own ETH and
# pays for its own attacks.
MEV_SEARCHER_KEY=""
MEV_SEARCHER_ADDRESS=""
# How hard the searcher outbids its victim for block position. Sepolia priority
# fees are ~0.001 gwei, so 25x costs a fraction of a cent.
MEV_SEARCHER_PRIORITY_MULTIPLE="25"
# Publicly reachable operator base URL, so KeeperHub's scheduler could call
# back in. Optional: the scheduled agent performs its swap itself precisely so
# no inbound reachability is required.
MEV_PUBLIC_URL=""

# ─── Perps ────────────────────────────────────────────────────────────────────
# The collateral vault. Deploy it with `forge script`, then run
# `scripts/provision-settlement.ts` — that capitalises the insurance fund by
# having KeeperHub sign its own deposit and hands it the settlement authority.
# Collateral is the same mUSD (MEV_QUOTE_TOKEN) the lab prices, so one faucet
# funds both halves.
DORR_VAULT_ADDRESS=""
# Optional: the block the vault was deployed at. Without it, settled-PnL
# reconciliation scans a bounded window back from the head instead — correct,
# just more RPC calls.
DORR_VAULT_DEPLOY_BLOCK=""
# Require an EIP-191 signature on value-moving perps actions. Off by default so
# a judge can click through without a wallet; set to 1 to enforce.
DORR_AUTH=""
# The account the terminal follows read-only when no wallet is connected, so a
# visitor sees the engine working instead of four "connect a wallet" panels.
# Defaults to ETH_DEPLOYER_ADDRESS. Its history is public on Etherscan either
# way; point it at a dedicated demo account if you would rather not use yours.
DORR_SPECTATOR_ADDRESS=""
# How often Chainlink feeds are re-read, in ms.
ORACLE_POLL_MS="15000"

# Public origin of the deployed web app. Used to resolve Open Graph image URLs;
# without it a shared link points its preview image at localhost.
NEXT_PUBLIC_SITE_URL=""
# Where the web app reaches the operator. Defaults to http://localhost:8790.
NEXT_PUBLIC_OPERATOR_URL=""
# Set to 1 to show the TanStack Query devtools panel in development. Off by
# default because the app is demoed in development mode.
NEXT_PUBLIC_SHOW_DEVTOOLS=""

OPERATOR_PORT="8790"
