# ─── MEV Shield ───────────────────────────────────────────────────────────────
# Everything needed to reproduce the public-vs-private duel on Ethereum Sepolia.
# Copy to `.env` and fill in the two credentials marked REQUIRED; the scripts
# write the rest back to `.env` themselves as they deploy.

# REQUIRED. Funds the deployment and the searcher bot. Needs ~0.05 Sepolia ETH:
# the lab deploy is ~0.005 and the rest is the adversary's gas and headroom.
ETH_DEPLOYER_ADDRESS=""
ETH_DEPLOYER_KEY=""

# REQUIRED. Org API key — `keeperhub-onboard.ts` mints one over SIWE using the
# deployer key above, and prints it along with the ORGANISATION wallet (a
# different address from the signer, and the one that actually executes).
KEEPERHUB_API_KEY=""
KEEPERHUB_BASE_URL="https://app.keeperhub.com"
KEEPERHUB_ORG_WALLET=""

# Written by mev-deploy.ts / the private lane on first use.
#
# The webhook key is the only credential that can fire a workflow, and it can
# only be minted from a browser session — `kh-session.ts` does that headlessly,
# so leaving this blank is fine.
KEEPERHUB_WEBHOOK_KEY=""
KEEPERHUB_PRIVATE_WORKFLOW_ID=""

# Sepolia. The WS endpoint is not optional: the searcher subscribes to
# `newPendingTransactions`, which plain HTTP RPC cannot deliver.
ETH_NETWORK="sepolia"
ETH_CHAIN_ID="11155111"
ETH_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
ETH_WS_URL="wss://ethereum-sepolia-rpc.publicnode.com"
ETH_EXPLORER="https://sepolia.etherscan.io"

# The lab. Written by mev-deploy.ts.
MEV_BASE_TOKEN=""
MEV_QUOTE_TOKEN=""
MEV_POOL=""

# The adversary. Generated by mev-deploy.ts if absent; it holds its own ETH and
# pays for its own attacks.
MEV_SEARCHER_KEY=""
MEV_SEARCHER_ADDRESS=""
# How hard the searcher outbids its victim for block position. Sepolia priority
# fees are ~0.001 gwei, so 25x costs a fraction of a cent.
MEV_SEARCHER_PRIORITY_MULTIPLE="25"

OPERATOR_PORT="8790"
